{
  "name": "feedfix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/fixtures.ts",
    "stats": "node --import tsx scripts/stats.ts",
    "walmart:schema:inspect": "node --max-old-space-size=384 --import tsx tools/walmart-schema/cli.ts inspect",
    "walmart:schema:compile": "node --max-old-space-size=384 --import tsx tools/walmart-schema/cli.ts compile",
    "walmart:schema:verify": "node --max-old-space-size=768 --import tsx tools/walmart-schema/cli.ts verify",
    "walmart:golden": "tsx tools/walmart-schema/golden-cli.ts",
    "walmart:fixtures": "tsx tools/walmart-schema/generate-official-fixture.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.4",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.11.1",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.6",
    "railway": "^3.11.0",
    "stream-json": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
