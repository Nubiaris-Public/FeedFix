APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Suggested optional support in integer USD cents. Downloads are always free.
STRIPE_PRICE_AMOUNT=499
# Local simulation only. Ignored in production. Use stripe for real Checkout.
PAYMENT_MODE=mock
MAX_UPLOAD_MB=25
# 45–59 minutes; cleanup runs every 30 seconds.
FILE_TTL_MINUTES=59
TEMP_STORE_DIR=.feedfix
# Required for real files: absolute path to reviewed schema JSON.
SCHEMA_PATH=
# Production preview only; never permits live purchase of synthetic files.
ALLOW_SYNTHETIC_FIXTURES=false
# Set ONLY when your proxy overwrites this header and cannot be bypassed.
TRUSTED_IP_HEADER=

# Writes only allowlisted aggregate funnel events to stdout.
ANALYTICS_ENABLED=true

# Optional Microsoft Clarity project ID (public). Leave empty to disable.
# Set before building; rebuild/redeploy after changing it.
CLARITY_PROJECT_ID=

# Persistent anonymous daily totals, separate from expiring spreadsheets.
USAGE_LOG_PATH=.feedfix-metrics/usage.json

# Enable only on the final public HTTPS production domain, not previews.
SEO_INDEXABLE=false
# HTML tag verification content from Google Search Console; not a secret.
GOOGLE_SITE_VERIFICATION=
