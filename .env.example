APP_URL=http://localhost:3000
# Server-only restricted API key (rk_test_… locally, rk_live_… in production).
# See docs/stripe-setup.md for account, webhook and workbook prerequisites.
STRIPE_SECRET_KEY=
# Local: stripe listen signing secret. Production: deployed endpoint secret.
STRIPE_WEBHOOK_SECRET=
# Suggested optional support in integer USD cents. Downloads are always free.
STRIPE_PRICE_AMOUNT=499
# Local simulation only. Ignored in production. Use stripe for real Checkout.
PAYMENT_MODE=mock
MAX_UPLOAD_MB=25
# 45–59 minutes; cleanup runs every 30 seconds.
FILE_TTL_MINUTES=59
TEMP_STORE_DIR=.feedfix
# Required for real files: absolute path to a reviewed small workbook mapping.
# The mapping binds data/walmart/compiled/<version>; NEVER point at the huge source.
SCHEMA_PATH=
# Allows clearly labeled synthetic previews; optional support needs Stripe keys.
ALLOW_SYNTHETIC_FIXTURES=false
# Set ONLY when your proxy overwrites this header and cannot be bypassed.
TRUSTED_IP_HEADER=

# Writes only allowlisted aggregate funnel events to stdout.
ANALYTICS_ENABLED=true

# Optional Microsoft Clarity project ID (public). Leave empty to disable.
# Set before building; rebuild/redeploy after changing it.
CLARITY_PROJECT_ID=

# Optional GA4 measurement ID (public), e.g. G-XXXXXXXXXX. Empty disables GA4.
# Set before building; rebuild/redeploy after changing it.
GA_MEASUREMENT_ID=

# Persistent anonymous daily totals, separate from expiring spreadsheets.
USAGE_LOG_PATH=.feedfix-metrics/usage.json

# Enable only on the final public HTTPS production domain, not previews.
SEO_INDEXABLE=false
# HTML tag verification content from Google Search Console; not a secret.
GOOGLE_SITE_VERIFICATION=

# Private originals shared with explicit consent, deleted within one hour.
# Must be separate from TEMP_STORE_DIR and outside public/. Docker: /data/study.
CORPUS_STORE_DIR=.feedfix-study
CORPUS_MAX_FILES=50
CORPUS_MAX_MB=256

# Private optional template callback addresses; fixed maximum retention 30 days.
NOTIFICATION_STORE_DIR=.feedfix-notifications
